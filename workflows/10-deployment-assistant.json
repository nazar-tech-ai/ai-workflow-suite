    {
      "parameters": {
        "jsCode": "const prompt = `\nYou are a Senior n8n Deployment Expert.\n\nAnalyze the user's business requirement and the similar workflow retrieved from the knowledge base.\n\nBusiness Requirement:\n${$json.requirement}\n\nWorkflow:\n${$json.workflow_name}\n\nSearch Score:\n${$json.search_score}\n\nProject Rating:\n${$json.project_rate}\n\nBusiness Value:\n${$json.business_value}\n\nDifficulty:\n${$json.difficulty}\n\nEstimated Hours:\n${$json.estimated_hours}\n\nAutomation Level:\n${$json.automation_level}\n\nMarket Insight:\n${$json.market_reason}\n\nCreate a complete deployment plan for this workflow.\n\nReturn ONLY valid JSON.\n\n{\n  \"deployment_title\":\"\",\n  \"deployment_strategy\":\"\",\n  \"required_services\":\"\",\n  \"environment_setup\":\"\",\n  \"deployment_steps\":\"\",\n  \"security_configuration\":\"\",\n  \"monitoring_strategy\":\"\",\n  \"backup_strategy\":\"\",\n  \"maintenance_plan\":\"\",\n  \"deployment_checklist\":\"\"\n}\n`;\n\nreturn [\n{\njson:{\npayload:{\ncontents:[\n{\nparts:[\n{\ntext:prompt\n}\n]\n}\n]\n}\n}\n}\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        608,
        -160
      ],
      "id": "f9af436e-8b9a-4fe0-ab31-dfd208fc0d33",
      "name": "Code (Build Deployment Prompt)"
    },
    {
      "parameters": {
        "jsCode": "const text = $json.candidates?.[0]?.content?.parts?.[0]?.text;\n\nif (!text) {\n  throw new Error(\"Gemini response not found.\");\n}\n\nconst clean = text\n.replace(/```json/gi,\"\")\n.replace(/```/g,\"\")\n.trim();\n\nlet deployment;\n\ntry{\n    deployment = JSON.parse(clean);\n}\ncatch(err){\n    throw new Error(\"Failed to parse Gemini JSON.\\n\\n\"+clean);\n}\n\nconst previous = $(\"Code (Extract Best Workflow)\").first().json;\n\nreturn [\n{\njson:{\n\nrequirement: previous.requirement,\nworkflow_name: previous.workflow_name,\nsearch_score: previous.search_score,\n\nproject_rate: previous.project_rate,\nbusiness_value: previous.business_value,\ndifficulty: previous.difficulty,\nestimated_hours: previous.estimated_hours,\nautomation_level: previous.automation_level,\n\ndeployment_title: deployment.deployment_title || \"\",\ndeployment_strategy: deployment.deployment_strategy || \"\",\nrequired_services: deployment.required_services || \"\",\nenvironment_setup: deployment.environment_setup || \"\",\ndeployment_steps: deployment.deployment_steps || \"\",\nsecurity_configuration: deployment.security_configuration || \"\",\nmonitoring_strategy: deployment.monitoring_strategy || \"\",\nbackup_strategy: deployment.backup_strategy || \"\",\nmaintenance_plan: deployment.maintenance_plan || \"\",\ndeployment_checklist: deployment.deployment_checklist || \"\",\n\ncreated_at: new Date().toISOString()\n\n}\n}\n];"
      },
      "type": "n8n-nodes-base.code",
