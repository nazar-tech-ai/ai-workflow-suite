    {
      "parameters": {
        "jsCode": "// Runs for EVERY item of the batch (old code used $input.first() and dropped the rest when batch_size > 1).\nconst urlCol = $('Configuration').first().json.linkedin_url_column;\nconst sheetRows = $('Loop over profiles').all();\nconst out = [];\n\n$input.all().forEach((it, i) => {\n  const item = it.json || {};\n  // Match the sheet row by the URL stored in the sheet (Apify may return a normalised URL that would not match)\n  const sheetUrl = (sheetRows[i] && sheetRows[i].json[urlCol]) || item.inputUrl || \"\";\n  const found = !item.error && (item.firstName || item.publicIdentifier || item.headline);\n\n  if (!found) {\n    out.push({ json: { __ok: false, \"LinkedIn URL\": sheetUrl, error: item.error?.message || item.error || \"Empty Apify result\" } });\n    return;\n  }\n\n  const mapped = {\n\n      // Original sheet columns\n      \"First name\": item.firstName ?? \"\",\n      \"Last name\": item.lastName ?? \"\",\n      \"Headline\": item.headline ?? \"\",\n      \"Job title\": item.jobTitle ?? \"\",\n      \"Company name\": item.companyName ?? \"\",\n      \"Country\": item.geoCountryName ?? \"\",\n      \"City\": item.geoLocationName ?? \"\",\n      \"Summary\": item.summary ?? \"\",\n      \"Skills\": JSON.stringify(item.skills ?? []),\n      \"Positions\": JSON.stringify(item.positions ?? []),\n      \"Educations\": JSON.stringify(item.educations ?? []),\n      \"Certifications\": JSON.stringify(item.certifications ?? []),\n\n      // Remaining Apify fields (same names as your sheet)\n      \"created\": item.created ?? \"\",\n      \"trackingId\": item.trackingId ?? \"\",\n      \"firstName\": item.firstName ?? \"\",\n      \"lastName\": item.lastName ?? \"\",\n      \"pronoun\": item.pronoun ?? \"\",\n      \"versionTag\": item.versionTag ?? \"\",\n      \"headline\": item.headline ?? \"\",\n      \"publicIdentifier\": item.publicIdentifier ?? \"\",\n      \"creator\": item.creator ?? false,\n      \"influencer\": item.influencer ?? false,\n      \"premium\": item.premium ?? false,\n      \"connectionType\": item.connectionType ?? \"\",\n      \"birthDate\": item.birthDate ?? \"\",\n      \"id\": item.id ?? \"\",\n      \"profileId\": item.profileId ?? \"\",\n      \"pictureUrl\": item.pictureUrl ?? \"\",\n      \"coverImageUrl\": item.coverImageUrl ?? \"\",\n      \"countryCode\": item.countryCode ?? \"\",\n      \"geoUrn\": item.geoUrn ?? \"\",\n      \"geoLocationName\": item.geoLocationName ?? \"\",\n      \"geoCountryName\": item.geoCountryName ?? \"\",\n      \"jobTitle\": item.jobTitle ?? \"\",\n      \"positions\": JSON.stringify(item.positions ?? []),\n      \"educations\": JSON.stringify(item.educations ?? []),\n      \"certifications\": JSON.stringify(item.certifications ?? []),\n      \"courses\": JSON.stringify(item.courses ?? []),\n      \"honors\": JSON.stringify(item.honors ?? []),\n      \"languages\": JSON.stringify(item.languages ?? []),\n      \"volunteerExperiences\": JSON.stringify(item.volunteerExperiences ?? []),\n      \"projects\": JSON.stringify(item.projects ?? []),\n      \"publications\": JSON.stringify(item.publications ?? []),\n      \"patents\": JSON.stringify(item.patents ?? []),\n      \"testScores\": JSON.stringify(item.testScores ?? []),\n      \"organizations\": JSON.stringify(item.organizations ?? []),\n      \"volunteerCauses\": JSON.stringify(item.volunteerCauses ?? []),\n      \"companyName\": item.companyName ?? \"\",\n      \"companyPublicId\": item.companyPublicId ?? \"\",\n      \"companyLinkedinUrl\": item.companyLinkedinUrl ?? \"\",\n      \"currentCompany\": JSON.stringify(item.currentCompany ?? {}),\n      \"followerCount\": item.followerCount ?? \"\",\n      \"mutualConnections\": item.mutualConnections ?? \"\",\n      \"isVerified\": item.isVerified ?? false,\n      \"verificationBadge\": JSON.stringify(item.verificationBadge ?? {}),\n      \"availablePremiumFeatures\": JSON.stringify(item.availablePremiumFeatures ?? {}),\n      \"pronunciationUrl\": item.pronunciationUrl ?? \"\",\n      \"connectionsCount\": item.connectionsCount ?? \"\",\n      \"skills\": JSON.stringify(item.skills ?? []),\n      \"inputUrl\": item.inputUrl ?? \"\"\n  };\n  out.push({ json: { __ok: true, ...mapped, \"LinkedIn URL\": sheetUrl } });\n});\n\nreturn out;"
      },
