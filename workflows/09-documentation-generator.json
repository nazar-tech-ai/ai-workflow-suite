    {
      "parameters": {
        "jsCode": "const prompt = `\nYou are a Senior AI Workflow Documentation Expert.\n\nAnalyze the user's business requirement and the similar workflow retrieved from the knowledge base.\n\nBusiness Requirement:\n${$json.requirement}\n\nWorkflow:\n${$json.workflow_name}\n\nSearch Score:\n${$json.search_score}\n\nProject Rating:\n${$json.project_rate}\n\nBusiness Value:\n${$json.business_value}\n\nDifficulty:\n${$json.difficulty}\n\nEstimated Hours:\n${$json.estimated_hours}\n\nAutomation Level:\n${$json.automation_level}\n\nMarket Insight:\n${$json.market_reason}\n\nCreate professional technical documentation for this workflow.\n\nReturn ONLY valid JSON.\n\n{\n  \"documentation_title\":\"\",\n  \"executive_summary\":\"\",\n  \"business_overview\":\"\",\n  \"workflow_architecture\":\"\",\n  \"required_nodes\":\"\",\n  \"implementation_steps\":\"\",\n  \"workflow_logic\":\"\",\n  \"integrations\":\"\",\n  \"error_handling\":\"\",\n  \"best_practices\":\"\",\n  \"deployment_guide\":\"\",\n  \"future_enhancements\":\"\"\n}\n`;\n\nreturn [\n{\njson:{\npayload:{\ncontents:[\n{\nparts:[\n{\ntext:prompt\n}\n]\n}\n]\n}\n}\n}\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1488,
        -512
      ],
      "id": "6be9ac33-8426-417f-875b-799a1b2e9d2d",
      "name": "Code (Build Documentation Prompt)"
    },
    {
      "parameters": {
        "jsCode": "const text = $json.candidates?.[0]?.content?.parts?.[0]?.text;\n\nif (!text) {\n  throw new Error(\"Gemini response not found.\");\n}\n\n// Remove markdown if Gemini returns ```json ... ```\nconst _s = text.indexOf(\"{\"), _e = text.lastIndexOf(\"}\");\nconst clean = (_s >= 0 && _e > _s ? text.slice(_s, _e + 1) : text).trim(); // tolerate prose around the JSON\n\nlet documentation;\n\ntry {\n  documentation = JSON.parse(clean);\n} catch (err) {\n  throw new Error(\n    \"Failed to parse Gemini JSON.\\n\\nResponse:\\n\" + clean\n  );\n}\n\n// Get previous workflow data\nconst previous = $(\"Code (Extract Best Workflow)\").first().json;\n\nreturn [\n  {\n    json: {\n      // Workflow Information\n      requirement: previous.requirement,\n      workflow_name: previous.workflow_name,\n      search_score: previous.search_score,\n\n      project_rate: previous.project_rate,\n      business_value: previous.business_value,\n      difficulty: previous.difficulty,\n      estimated_hours: previous.estimated_hours,\n      automation_level: previous.automation_level,\n\n      // Documentation Output\n      documentation_title: documentation.documentation_title || \"\",\n      executive_summary: documentation.executive_summary || \"\",\n      business_overview: documentation.business_overview || \"\",\n      workflow_architecture: documentation.workflow_architecture || \"\",\n      required_nodes: documentation.required_nodes || \"\",\n      implementation_steps: documentation.implementation_steps || \"\",\n      workflow_logic: documentation.workflow_logic || \"\",\n      integrations: documentation.integrations || \"\",\n      error_handling: documentation.error_handling || \"\",\n      best_practices: documentation.best_practices || \"\",\n      deployment_guide: documentation.deployment_guide || \"\",\n      future_enhancements: documentation.future_enhancements || \"\",\n\n      created_at: new Date().toISOString()\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1072,
        -512
      ],
      "id": "9910c7a0-a69f-4823-a97a-700c28c2b53c",
      "name": "Code (Extract Documentation JSON)"
    },
    {
      "parameters": {
        "jsCode": "// --- safe rendering helpers (model output is untrusted: escape before putting it into HTML) ---\nconst esc = (s) => String(s ?? \"\").replace(/&/g,\"&amp;\").replace(/</g,\"&lt;\").replace(/>/g,\"&gt;\").replace(/\"/g,\"&quot;\").replace(/'/g,\"&#39;\");\nconst fmt = (v) => {\n  if (Array.isArray(v)) return \"<ul>\" + v.map(x => \"<li>\" + fmt(x) + \"</li>\").join(\"\") + \"</ul>\";\n  if (v && typeof v === \"object\") return \"<ul>\" + Object.entries(v).map(([k,x]) => \"<li><strong>\" + esc(k) + \":</strong> \" + fmt(x) + \"</li>\").join(\"\") + \"</ul>\";\n  return esc(v).replace(/\\n/g,\"<br>\");\n};\nconst html = `\n<!DOCTYPE html>\n<html>\n<head>\n<meta charset=\"UTF-8\">\n<title>${fmt($json.documentation_title)}</title>\n\n<style>\nbody{\nfont-family:Arial,sans-serif;\nmargin:40px;\nline-height:1.7;\ncolor:#333;\nbackground:#fff;\n}\n\nh1{\ncolor:#0f172a;\nborder-bottom:3px solid #2563eb;\npadding-bottom:10px;\n}\n\nh2{\ncolor:#2563eb;\nmargin-top:35px;\nborder-left:5px solid #2563eb;\npadding-left:10px;\n}\n\n.section{\nmargin-bottom:25px;\n}\n\n.footer{\nmargin-top:50px;\nfont-size:12px;\ncolor:#666;\nborder-top:1px solid #ddd;\npadding-top:15px;\ntext-align:center;\n}\n</style>\n\n</head>\n\n<body>\n\n<h1>${fmt($json.documentation_title)}</h1>\n\n<div class=\"section\">\n<h2>Executive Summary</h2>\n<p>${fmt($json.executive_summary)}</p>\n</div>\n\n<div class=\"section\">\n<h2>Business Overview</h2>\n<p>${fmt($json.business_overview)}</p>\n</div>\n\n<div class=\"section\">\n<h2>Workflow Architecture</h2>\n<p>${fmt($json.workflow_architecture)}</p>\n</div>\n\n<div class=\"section\">\n<h2>Required Nodes</h2>\n<p>${fmt($json.required_nodes)}</p>\n</div>\n\n<div class=\"section\">\n<h2>Implementation Steps</h2>\n<p>${fmt($json.implementation_steps)}</p>\n</div>\n\n<div class=\"section\">\n<h2>Workflow Logic</h2>\n<p>${fmt($json.workflow_logic)}</p>\n</div>\n\n<div class=\"section\">\n<h2>Integrations</h2>\n<p>${fmt($json.integrations)}</p>\n</div>\n\n<div class=\"section\">\n<h2>Error Handling</h2>\n<p>${fmt($json.error_handling)}</p>\n</div>\n\n<div class=\"section\">\n<h2>Best Practices</h2>\n<p>${fmt($json.best_practices)}</p>\n</div>\n\n<div class=\"section\">\n<h2>Deployment Guide</h2>\n<p>${fmt($json.deployment_guide)}</p>\n</div>\n\n<div class=\"section\">\n<h2>Future Enhancements</h2>\n<p>${fmt($json.future_enhancements)}</p>\n</div>\n\n<div class=\"footer\">\nGenerated automatically by AI Workflow Documentation Generator\n</div>\n\n</body>\n</html>\n`;\n\nreturn [\n{\njson:{\n...$json,\nhtml_document: html\n}\n}\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
