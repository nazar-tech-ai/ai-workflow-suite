    {
      "parameters": {
        "jsCode": "// Get HTML from previous node\nconst html = $json.html_document;\n\nif (!html) {\n  throw new Error(\"html_document field not found.\");\n}\n\n// Convert HTML to Base64\nconst base64Data = Buffer.from(html, \"utf8\").toString(\"base64\");\n\n// Return JSON + Binary\nreturn [\n  {\n    json: {\n      ...$json\n    },\n    binary: {\n      files: {\n        data: base64Data,\n        mimeType: \"text/html\",\n        fileName: \"index.html\"\n      }\n    }\n  }\n];"
      },
