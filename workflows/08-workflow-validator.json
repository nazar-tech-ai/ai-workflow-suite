    {
      "parameters": {
        "jsCode": "const prompt = `\nYou are a Senior n8n Workflow Validation Expert.\n\nAnalyze the user's business requirement and the similar workflow retrieved from the knowledge base.\n\nBusiness Requirement:\n${$json.requirement}\n\nWorkflow:\n${$json.workflow_name}\n\nSearch Score:\n${$json.search_score}\n\nProject Rating:\n${$json.project_rate}\n\nBusiness Value:\n${$json.business_value}\n\nDifficulty:\n${$json.difficulty}\n\nEstimated Hours:\n${$json.estimated_hours}\n\nAutomation Level:\n${$json.automation_level}\n\nMarket Insight:\n${$json.market_reason}\n\nValidate this workflow for correctness, completeness and production readiness.\n\nReturn ONLY valid JSON.\n\n{\n  \"validation_title\":\"\",\n  \"overall_status\":\"\",\n  \"workflow_completeness\":\"\",\n  \"logic_validation\":\"\",\n  \"node_validation\":\"\",\n  \"integration_validation\":\"\",\n  \"security_validation\":\"\",\n  \"performance_validation\":\"\",\n  \"issues_found\":\"\",\n  \"recommendation\":\"\"\n}\n`;\n\nreturn [\n{\njson:{\npayload:{\ncontents:[\n{\nparts:[\n{\ntext:prompt\n}\n]\n}\n]\n}\n}\n}\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        -288
      ],
      "id": "182d2487-8334-481a-9b56-f408626ecb4d",
      "name": "Code (Build Validator Prompt)"
    },
    {
      "parameters": {
        "jsCode": "const text = $json.candidates?.[0]?.content?.parts?.[0]?.text;\n\nif (!text) {\n  throw new Error(\"Gemini response not found.\");\n}\n\nconst clean = text\n.replace(/```json/gi,\"\")\n.replace(/```/g,\"\")\n.trim();\n\nlet validation;\n\ntry{\n    validation = JSON.parse(clean);\n}\ncatch(err){\n    throw new Error(\"Failed to parse Gemini JSON.\\n\\n\"+clean);\n}\n\nconst previous = $(\"Code (Extract Best Workflow)\").first().json;\n\nreturn [\n{\njson:{\n\nrequirement: previous.requirement,\nworkflow_name: previous.workflow_name,\nsearch_score: previous.search_score,\n\nproject_rate: previous.project_rate,\nbusiness_value: previous.business_value,\ndifficulty: previous.difficulty,\nestimated_hours: previous.estimated_hours,\nautomation_level: previous.automation_level,\n\nvalidation_title: validation.validation_title || \"\",\noverall_status: validation.overall_status || \"\",\nworkflow_completeness: validation.workflow_completeness || \"\",\nlogic_validation: validation.logic_validation || \"\",\nnode_validation: validation.node_validation || \"\",\nintegration_validation: validation.integration_validation || \"\",\nsecurity_validation: validation.security_validation || \"\",\nperformance_validation: validation.performance_validation || \"\",\nissues_found: validation.issues_found || \"\",\nrecommendation: validation.recommendation || \"\",\n\ncreated_at: new Date().toISOString()\n\n}\n}\n];"
      },
