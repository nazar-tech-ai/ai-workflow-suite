    {
      "parameters": {
        "jsCode": "const prompt = `\nYou are a Senior n8n Workflow Optimization Expert.\n\nAnalyze the user's business requirement and the similar workflow retrieved from the knowledge base.\n\nBusiness Requirement:\n${$json.requirement}\n\nCurrent Workflow:\n${$json.workflow_name}\n\nSearch Score:\n${$json.search_score}\n\nProject Rating:\n${$json.project_rate}\n\nBusiness Value:\n${$json.business_value}\n\nDifficulty:\n${$json.difficulty}\n\nEstimated Hours:\n${$json.estimated_hours}\n\nAutomation Level:\n${$json.automation_level}\n\nMarket Insight:\n${$json.market_reason}\n\nYour task is to optimize this workflow.\n\nSuggest improvements for performance, scalability, maintainability, cost reduction and reliability.\n\nReturn ONLY valid JSON.\n\n{\n  \"optimization_title\":\"\",\n  \"current_analysis\":\"\",\n  \"performance_improvements\":\"\",\n  \"cost_optimization\":\"\",\n  \"node_optimization\":\"\",\n  \"scalability_recommendations\":\"\",\n  \"security_recommendations\":\"\",\n  \"best_practices\":\"\",\n  \"estimated_performance_gain\":\"\",\n  \"final_recommendation\":\"\"\n}\n`;\n\nreturn [\n{\njson:{\npayload:{\ncontents:[\n{\nparts:[\n{\ntext:prompt\n}\n]\n}\n]\n}\n}\n}\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        560,
        -160
      ],
      "id": "e52d523f-fb96-4ac0-8d86-9d6c3fd9ea19",
      "name": "Code (Build Optimizer Prompt)"
    },
    {
      "parameters": {
        "jsCode": "const text = $json.candidates?.[0]?.content?.parts?.[0]?.text;\n\nif (!text) {\n  throw new Error(\"Gemini response not found.\");\n}\n\nconst clean = text\n.replace(/```json/gi,\"\")\n.replace(/```/g,\"\")\n.trim();\n\nlet optimization;\n\ntry{\n    optimization = JSON.parse(clean);\n}\ncatch(err){\n    throw new Error(\"Failed to parse Gemini JSON.\\n\\n\"+clean);\n}\n\nconst previous = $(\"Code (Extract Best Workflow)\").first().json;\n\nreturn [\n{\njson:{\n\nrequirement: previous.requirement,\nworkflow_name: previous.workflow_name,\nsearch_score: previous.search_score,\n\nproject_rate: previous.project_rate,\nbusiness_value: previous.business_value,\ndifficulty: previous.difficulty,\nestimated_hours: previous.estimated_hours,\nautomation_level: previous.automation_level,\n\noptimization_title: optimization.optimization_title || \"\",\ncurrent_analysis: optimization.current_analysis || \"\",\nperformance_improvements: optimization.performance_improvements || \"\",\ncost_optimization: optimization.cost_optimization || \"\",\nnode_optimization: optimization.node_optimization || \"\",\nscalability_recommendations: optimization.scalability_recommendations || \"\",\nsecurity_recommendations: optimization.security_recommendations || \"\",\nbest_practices: optimization.best_practices || \"\",\nestimated_performance_gain: optimization.estimated_performance_gain || \"\",\nfinal_recommendation: optimization.final_recommendation || \"\",\n\ncreated_at: new Date().toISOString()\n\n}\n}\n];"
      },
