    {
      "parameters": {
        "jsCode": "const prompt = `\nYou are a Senior n8n AI Workflow Architect.\n\nYour task is to design a complete workflow based on the user's business requirement.\n\nBusiness Requirement:\n${$json.requirement}\n\nSimilar Workflow Found:\n${$json.workflow_name}\n\nWorkflow Analysis\n\nSearch Score:\n${$json.search_score}\n\nProject Rating:\n${$json.project_rate}\n\nBusiness Value:\n${$json.business_value}\n\nDifficulty:\n${$json.difficulty}\n\nEstimated Development Hours:\n${$json.estimated_hours}\n\nAutomation Level:\n${$json.automation_level}\n\nMarket Insight:\n${$json.market_reason}\n\nGenerate a complete n8n workflow design.\n\nReturn ONLY valid JSON.\n\n{\n  \"workflow_title\":\"\",\n  \"business_overview\":\"\",\n  \"trigger_node\":\"\",\n  \"required_nodes\":[\n    {\n      \"node_name\":\"\",\n      \"purpose\":\"\"\n    }\n  ],\n  \"workflow_logic\":\"\",\n  \"implementation_steps\":\"\",\n  \"integrations\":[\n    \"\"\n  ],\n  \"error_handling\":\"\",\n  \"estimated_hours\":\"\",\n  \"complexity\":\"\",\n  \"future_enhancements\":\"\"\n}\n`;\n\nreturn [\n  {\n    json: {\n      payload: {\n        contents: [\n          {\n            parts: [\n              {\n                text: prompt\n              }\n            ]\n          }\n        ]\n      }\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        160,
        -128
      ],
      "id": "27344304-23e4-4cb9-8f62-b55a20c1159e",
      "name": "Code (Build Workflow Generation Prompt)"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-3.5-flash-lite:generateContent",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ Object.assign({}, $json.payload, { generationConfig: Object.assign({ temperature: 0.2, responseMimeType: \"application/json\" }, $json.payload.generationConfig || {}) }) }}",
        "options": {
          "response": {
            "response": {}
          },
          "timeout": 60000
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        368,
        -128
      ],
      "id": "fa0e8a1e-ee73-4c39-90e6-cf4598047f03",
      "name": "HTTP Request (Gemini 3.5 Flash Lite)",
      "retryOnFail": true,
      "waitBetweenTries": 3000,
      "maxTries": 5,
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": "Gemini API Key (Header Auth)"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const text = $json.candidates?.[0]?.content?.parts?.[0]?.text;\n\nif (!text) {\n  throw new Error(\"Gemini response not found.\");\n}\n\n// Remove markdown if Gemini returns ```json ... ```\nconst _s = text.indexOf(\"{\"), _e = text.lastIndexOf(\"}\");\nconst clean = (_s >= 0 && _e > _s ? text.slice(_s, _e + 1) : text).trim(); // tolerate prose around the JSON\n\nlet workflow;\n\ntry {\n  workflow = JSON.parse(clean);\n} catch (err) {\n  throw new Error(\n    \"Failed to parse Gemini JSON.\\n\\nResponse:\\n\" + clean\n  );\n}\n\n// Get previous workflow data\nconst previous = $(\"Code (Extract Best Workflow)\").first().json;\n\nreturn [\n  {\n    json: {\n      requirement: previous.requirement,\n      workflow_name: previous.workflow_name,\n      search_score: previous.search_score,\n\n      project_rate: previous.project_rate,\n      business_value: previous.business_value,\n      difficulty: previous.difficulty,\n      estimated_hours: previous.estimated_hours,\n      automation_level: previous.automation_level,\n\n      workflow_title: workflow.workflow_title,\n      business_overview: workflow.business_overview,\n      trigger_node: workflow.trigger_node,\n\n      required_nodes: JSON.stringify(\n        workflow.required_nodes || [],\n        null,\n        2\n      ),\n\n      workflow_logic: workflow.workflow_logic,\n      implementation_steps: workflow.implementation_steps,\n\n      integrations: (workflow.integrations || []).join(\", \"),\n\n      error_handling: workflow.error_handling,\n      complexity: workflow.complexity,\n      future_enhancements: workflow.future_enhancements,\n\n      created_at: new Date().toISOString()\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        592,
        -128
      ],
      "id": "7165f664-29b5-4b04-a61f-560ca7faf239",
      "name": "Code (Extract Workflow JSON)"
    },
    {
      "parameters": {
        "jsCode": "const MIN_SCORE = 0.55; // ignore weak matches instead of consulting the LLM about an unrelated workflow\nconst results = $json.result || [];\nif (!results.length) throw new Error(\"No similar workflow found in Qdrant.\");\n\n// Qdrant returns CHUNKS: pick the best chunk, but never trust a weak one\nconst best = results[0];\nif ((best.score || 0) < MIN_SCORE) {\n  throw new Error(`Best match score ${best.score} is below ${MIN_SCORE}. No relevant workflow in the knowledge base.`);\n}\nconst payload = best.payload || {};\n// Market fields live on every chunk of the workflow after Project 2 runs; fall back to any chunk that has them\nconst withMarket = results.find(r => r.payload && r.payload.workflow_name === payload.workflow_name && r.payload.project_rate != null) || best;\nconst m = withMarket.payload || {};\n\nreturn [{\n  json: {\n    requirement: $(\"Code (Extract Embedding)1\").first().json.requirement,\n    workflow_name: payload.workflow_name || \"\",\n    search_score: best.score || 0,\n    project_rate: m.project_rate ?? 0,\n    business_value: m.business_value ?? 0,\n    difficulty: m.difficulty || \"\",\n    estimated_hours: m.estimated_hours ?? 0,\n    automation_level: m.automation_level || \"\",\n    market_reason: m.market_reason || \"\"\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
